generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  passwordHash  String?
  createdAt     DateTime        @default(now())
  role          Role            @default(USER)
  avatarUrl     String?
  goalDaily     Int             @default(30)
  goalWeekly    Int             @default(5)
  goalStreak    Int             @default(14)
  progress      Progress[]
  enrollments   Enrollment[]
  blockProgress BlockProgress[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  level       String?
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  capsules    Capsule[]
  enrollments Enrollment[]
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Capsule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int
  modules   Module[]
}

model Module {
  id        String   @id @default(cuid())
  capsuleId String
  capsule   Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int
  isLocked  Boolean  @default(false)
  chapters  Chapter[]
}

model Chapter {
  id            String          @id @default(cuid())
  moduleId      String
  module        Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title         String
  sortOrder     Int
  mdPath        String
  estMin        Int?
  isPublished   Boolean         @default(false)
  progress      Progress[]
  blockProgress BlockProgress[]
}

model BlockProgress {
  id         String   @id @default(cuid())
  userId     String
  chapterId  String
  blockId    String
  answeredAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId, blockId])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  chapterId String
  status    ProgressStatus @default(NOT_STARTED)
  score     Int?
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
